{
  "name": "@automation/referenced-automation-utils",
  "version": "1.0.0",
  "description": "Shared, framework-agnostic utilities (env config, logging, crypto, date, random data, JSON/YAML/CSV/Excel, schema validation, object path traversal, email, DB) reused by every other referenced-automation-* repo.",
  "license": "UNLICENSED",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "agent"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf --glob dist \"*.tgz\"",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "test": "playwright test",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "security": "node dist/cli/auditGate.js --allow-unassigned && node dist/cli/scanSecrets.js",
    "audit": "node dist/cli/frameworkAudit.js --run",
    "audit:quick": "node dist/cli/frameworkAudit.js",
    "remote": "node dist/cli/remote.js",
    "run-report": "node dist/cli/runReport.js",
    "scan-secrets": "node dist/cli/scanSecrets.js",
    "audit-gate": "node dist/cli/auditGate.js",
    "framework-audit": "node dist/cli/frameworkAudit.js"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.5.2",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "imapflow": "^1.0.181",
    "js-yaml": "^4.1.0",
    "lodash": "^4.18.1",
    "mailparser": "^3.7.2",
    "nodemailer": "^10.0.15",
    "smtp-server": "^3.19.3",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "winston": "^3.17.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.25",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/smtp-server": "^3.5.13",
    "@types/ssh2": "^1.15.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.64.0 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "bin": {
    "automation-audit-gate": "./dist/cli/auditGate.js",
    "automation-scan-secrets": "./dist/cli/scanSecrets.js",
    "automation-run-report": "./dist/cli/runReport.js",
    "automation-framework-audit": "./dist/cli/frameworkAudit.js",
    "automation-remote": "./dist/cli/remote.js"
  }
}
