# Dependencies
node_modules/

# Build output
dist/
*.tgz

# Test output
test-results/
playwright-report/
blob-report/
.last-run.json
logs/
*.log

# Local env overrides - never commit real secrets. .env.<env> template files
# (.env.qa, .env.stage, .env.dev) ARE committed; only the local override is not.
.env
.env.local

# OS / editor
.DS_Store
Thumbs.db
*.swp

# IntelliJ - keep shared project config, ignore machine-specific state
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/shelf/
.idea/httpRequests/
.idea/dataSources/
.idea/dataSources.local.xml
*.iml
out/

# VS Code - keep shared settings/extensions, ignore machine-specific state
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# Eclipse / other IDEs
.project
.classpath
.settings/
