# Copy this to .env.<yourenv>.local for secrets that must never be committed
# (real passwords, tokens, connection strings). Anything here is safe to
# commit as a template/default - see .env.qa / .env.stage / .env.dev for the
# actual per-environment values used by this repo's own tests.

LOG_LEVEL=info
TZ=UTC

# Example values every consuming repo's own .env.<env> files add on top of
# this pattern (BASE_URL for UI, API_BASE_URL for API, etc.):
# BASE_URL=https://qa.example.com
# API_BASE_URL=https://api.qa.example.com
# API_KEY=replace-me
