# =============================================================================
# Configuration reference - EVERY environment variable referenced-automation-utils reads.
# This file is documentation: nothing loads it. Copy the lines you need into
#
#   .env.<name>          committed, NO secrets      (.env.qa, .env.stage, .env.dev)
#   .env.<name>.local    git-ignored, secrets only  (template: .env.local.example)
#
# and pick the file with the ENV variable (default qa). Load order, later wins:
#   .env -> .env.<ENV> -> .env.<ENV>.local -> the real environment (shell / CI variables).
# The secret file is named after the environment: ENV=qa reads .env.qa.local, NOT .env.local.
#
# Every variable below is documented the same way, on the lines above it:
#   what it is for / Read from / Values / Default | Required | Secret / Example
# "Read from" matters: a variable marked "real environment only" is read straight from
# process.env, so a line for it in a .env file has NO effect - set it in the shell or in CI:
#   bash / zsh : LOG_LEVEL=debug npx playwright test
#   PowerShell : $env:LOG_LEVEL = "debug"; npx playwright test      (undo: Remove-Item Env:LOG_LEVEL)
#   cmd.exe    : set LOG_LEVEL=debug && npx playwright test
#
# TIP - quoting values (dotenv rules):
#   * A value that contains # (starts a comment: PASSWORD=pa#ss is read as "pa"), $, quotes, or leading/trailing
#     spaces must be wrapped in double quotes:  REMOTE_RDP_PASSWORD="pa#ss $word 'x'"
#   * Inside double quotes \n becomes a line break, so a Windows value with backslashes (DOMAIN\new-user,
#     C:\new\dir) is safer unquoted or in single quotes:  REMOTE_RDP_USER='DOMAIN\new-user'
#   * A value that itself contains a double quote goes in single quotes:  NOTE='say "hi"'
#   * A key with an empty value (KEY=) is set to the empty string, which is not the same as not set.
#
# Secrets (Secret: YES) belong in .env.<name>.local or the CI secret store - never in a committed file:
#   cp .env.local.example .env.qa.local          (PowerShell: Copy-Item .env.local.example .env.qa.local)
#
# Variable lines below are commented out; remove the leading "# " to use one.
# Tests that check this file: tests/envDocs.spec.ts (every variable the code reads is here, and nothing else).
# =============================================================================


# ---- Environment selection ---------------------------------------------------------------------------------------

# Which environment to run against = which .env.<name> files are loaded and what is shown as "env" in the report.
# Read from: the real environment only (it chooses the file, so a line ENV=... inside a file is ignored).
# Values: any name that has a .env.<name> file here: qa | stage | dev | your own   (a name with no file just loads no file)
# Default: qa | Required: no | Secret: no
# Example: ENV=stage
# ENV=qa

# Fallback name for ENV, for machines where another tool already owns ENV. ENV wins when both are set.
# Read from: the real environment only
# Values: same as ENV
# Default: unset (then qa) | Required: no | Secret: no
# Example: ENVIRONMENT=stage
# ENVIRONMENT=qa


# ---- Target URLs (set per repo; utils itself has no application under test) --------------------------------------

# Base URL of the web application. createPlaywrightConfig makes it Playwright's baseURL, so page.goto('/login') works.
# Read from: .env files or the real environment (used by UI suites; the API suites read API_BASE_URL instead)
# Values: an absolute URL with scheme, e.g. https://qa.example.com
# Default: unset | Required: no for the config itself; yes for any test that opens a relative URL | Secret: no
# Example: BASE_URL=https://qa.example.com
# BASE_URL=https://qa.example.com

# Base URL of the API under test (what API suites pass as baseUrlKey to createPlaywrightConfig).
# Read from: .env files or the real environment
# Values: an absolute URL with scheme, e.g. https://api.qa.example.com
# Default: unset | Required: no for the config itself; yes for any test that calls a relative path | Secret: no
# Example: API_BASE_URL=https://api.qa.example.com
# API_BASE_URL=https://api.qa.example.com


# ---- Browser and run selection (createPlaywrightConfig) ----------------------------------------------------------

# Which browser(s) to run. An unknown value fails at start-up with the list of valid names.
# Read from: .env files or the real environment
# Values: chromium | firefox | webkit | msedge | msedge-beta | msedge-dev | chrome | chrome-beta | chrome-dev | all (the three engines) | all-devices (the mobile devices)
# Default: chromium | Required: no | Secret: no
# Example: BROWSER=firefox
# BROWSER=chromium

# Emulate one Playwright device instead of a desktop browser; wins over BROWSER. An unknown name fails at start-up.
# Read from: .env files or the real environment
# Values: any name in Playwright's device list, e.g. "iPhone 15", "Pixel 7", "iPad Pro 11" (quote names with spaces)
# Default: unset (then BROWSER decides) | Required: no | Secret: no
# Example: DEVICE="iPhone 15"
# DEVICE=

# Run the browser without a window.
# Read from: .env files or the real environment
# Values: true | false (also 1/0, yes/no, on/off; anything else, such as "ture", is an error)
# Default: true | Required: no | Secret: no
# Example: HEADLESS=false
# HEADLESS=true

# How many test files run at the same time.
# Read from: .env files or the real environment
# Values: a whole number >= 1, or a percentage of the logical cores such as 50%; a suite that passes maxWorkers (SAP: 1) is capped by it
# Default: unset (Playwright uses half of the logical cores) | Required: no | Secret: no
# Example: WORKERS=4
# WORKERS=

# How often a failed test is run again before it counts as failed (a test that passes on a retry is reported as flaky).
# Read from: .env files or the real environment
# Values: a whole number >= 0
# Default: 0 on a developer machine; 1 when the CI variable is set (the repo's retriesOnCi option can change that) | Required: no | Secret: no
# Example: RETRIES=2
# RETRIES=0

# Stop the whole run after this many failed tests.
# Read from: .env files or the real environment
# Values: a whole number >= 0 (0 = never stop early)
# Default: 0 | Required: no | Secret: no
# Example: MAX_FAILURES=5
# MAX_FAILURES=0

# Slow every browser action down so a person can watch (debugging only).
# Read from: .env files or the real environment
# Values: milliseconds, a whole number >= 0 (0 = off)
# Default: 0 | Required: no | Secret: no
# Example: SLOW_MO_MS=250
# SLOW_MO_MS=0

# Width of the browser window for desktop projects.
# Read from: .env files or the real environment
# Values: pixels, a whole number
# Default: 1280 | Required: no | Secret: no
# Example: VIEWPORT_WIDTH=1920
# VIEWPORT_WIDTH=1280

# Height of the browser window for desktop projects.
# Read from: .env files or the real environment
# Values: pixels, a whole number
# Default: 800 | Required: no | Secret: no
# Example: VIEWPORT_HEIGHT=1080
# VIEWPORT_HEIGHT=800

# Browser language (navigator.language, Accept-Language, date and number formats).
# Read from: .env files or the real environment
# Values: a BCP 47 tag such as en-GB, de-DE, fr-CA
# Default: unset (the browser's own) | Required: no | Secret: no
# Example: LOCALE=en-GB
# LOCALE=

# Browser time zone, so date assertions do not depend on where the test machine is.
# Read from: .env files or the real environment
# Values: an IANA zone name such as Europe/London, America/New_York, UTC
# Default: unset (the machine's own) | Required: no | Secret: no
# Example: TIMEZONE_ID=Europe/London
# TIMEZONE_ID=

# Emulated prefers-color-scheme.
# Read from: .env files or the real environment
# Values: light | dark | no-preference
# Default: unset (the browser's own) | Required: no | Secret: no
# Example: COLOR_SCHEME=dark
# COLOR_SCHEME=

# Accept invalid or self-signed HTTPS certificates (test environments only).
# Read from: .env files or the real environment
# Values: true | false (also 1/0, yes/no, on/off)
# Default: false | Required: no | Secret: no
# Example: IGNORE_HTTPS_ERRORS=true
# IGNORE_HTTPS_ERRORS=false

# The attribute getByTestId() looks at.
# Read from: .env files or the real environment
# Values: an HTML attribute name, e.g. data-testid, data-test, data-qa
# Default: data-testid | Required: no | Secret: no
# Example: TEST_ID_ATTRIBUTE=data-test
# TEST_ID_ATTRIBUTE=data-testid


# ---- Timeouts, all in milliseconds (createPlaywrightConfig) ------------------------------------------------------

# How long one whole test may take.
# Read from: .env files or the real environment
# Values: milliseconds, a whole number
# Default: 30000 (a repo can change the default through the testTimeoutMs option) | Required: no | Secret: no
# Example: TEST_TIMEOUT_MS=60000
# TEST_TIMEOUT_MS=30000

# How long a web-first assertion (expect(...)) waits for its condition.
# Read from: .env files or the real environment
# Values: milliseconds, a whole number
# Default: 10000 | Required: no | Secret: no
# Example: EXPECT_TIMEOUT_MS=15000
# EXPECT_TIMEOUT_MS=10000

# How long one action (click, fill, ...) waits for its element.
# Read from: .env files or the real environment
# Values: milliseconds, a whole number
# Default: 15000 | Required: no | Secret: no
# Example: ACTION_TIMEOUT_MS=20000
# ACTION_TIMEOUT_MS=15000

# How long a navigation (page.goto, link clicks) waits.
# Read from: .env files or the real environment
# Values: milliseconds, a whole number
# Default: 30000 | Required: no | Secret: no
# Example: NAVIGATION_TIMEOUT_MS=60000
# NAVIGATION_TIMEOUT_MS=30000

# How long the whole run may take before Playwright stops it.
# Read from: .env files or the real environment
# Values: milliseconds, a whole number (0 = no limit)
# Default: 0 | Required: no | Secret: no
# Example: GLOBAL_TIMEOUT_MS=3600000
# GLOBAL_TIMEOUT_MS=0


# ---- Logging (logger/logger.ts) ----------------------------------------------------------------------------------

# Minimum level written to the console and the log file.
# Read from: the real environment only (the logger reads process.env once, when it is first imported; .env files are not read)
# Values: error | warn | info | http | verbose | debug | silly
# Default: info | Required: no | Secret: no
# Example: LOG_LEVEL=debug
# LOG_LEVEL=info

# Also write the JSON-lines log file (a CI artifact). If the file cannot be created the logger carries on with the console only.
# Read from: the real environment only
# Values: true | false (only the text "false", any case, turns it off)
# Default: true | Required: no | Secret: no
# Example: LOG_TO_FILE=false
# LOG_TO_FILE=true

# Where the log file is written.
# Read from: the real environment only
# Values: a path, relative to the folder tests start in or absolute
# Default: logs/automation.log | Required: no | Secret: no
# Example: LOG_FILE=logs/run-42.log
# LOG_FILE=logs/automation.log

# One log file per Playwright worker (logs/automation-w2.log) instead of every worker appending to one file.
# Read from: the real environment only
# Values: true | false (only the text "true", any case, turns it on)
# Default: false | Required: no | Secret: no
# Example: LOG_FILE_PER_WORKER=true
# LOG_FILE_PER_WORKER=false

# Switch coloured console output off. Colour is already off when CI is set or the output is not a terminal.
# Read from: the real environment only
# Values: any non-empty value turns colour off (the NO_COLOR convention)
# Default: unset | Required: no | Secret: no
# Example: NO_COLOR=1
# NO_COLOR=

# Switch coloured console output on even in CI or when the output is piped.
# Read from: the real environment only
# Values: any non-empty value turns colour on (even 0 or false - it is the presence that counts)
# Default: unset | Required: no | Secret: no
# Example: FORCE_COLOR=1
# FORCE_COLOR=


# ---- Test data -----------------------------------------------------------------------------------------------------

# Seeds the random-data generators (randomUtils, {{random:...}} placeholders) for every Playwright worker, so a failing
# run can be replayed with the same data. The seed in use is logged at start-up.
# Read from: the real environment only
# Values: an integer
# Default: unset (a different random seed every run) | Required: no | Secret: no
# Example: RANDOM_SEED=12345
# RANDOM_SEED=


# ---- Mainframe (3270) -------------------------------------------------------------------------------------------------

# The s3270 program (from the x3270 suite) that Tn3270Session drives. Only needed when s3270 is not on the PATH.
# Read from: the real environment only
# Values: a command name or the full path of the s3270 executable (single-quote a Windows path with spaces)
# Default: s3270 (looked up on the PATH) | Required: no | Secret: no
# Example: S3270_PATH='C:\Program Files\wc3270\ws3270.exe'
# S3270_PATH=

# How long a 3270 wait (waitForText, waiting for the keyboard to unlock) lasts before it fails with the screen as it was.
# Read from: the real environment only
# Values: milliseconds, a whole number >= 1
# Default: 30000 | Required: no | Secret: no
# Example: TN3270_TIMEOUT_MS=60000
# TN3270_TIMEOUT_MS=30000


# ---- Remote desktop host (docs/REMOTE_DESKTOP.md) - NOT VERIFIED on a real Windows host -----------------------------------
# Run DB / HTTP / SAP steps on a remote Windows host that is reachable only by Remote Desktop (for example from an AWS
# WorkSpace). All REMOTE_* keys are read through remote.remoteConfigFromEnv(), so they work in .env files and in the real
# environment; with REMOTE_ENABLED unset or false every other REMOTE_* key is ignored. The other repos (api, ui-api, sap)
# use these same keys: this is the only complete list. Put REMOTE_RDP_PASSWORD and REMOTE_DB_CONNECTION_STRING in
# .env.<name>.local, never in a committed file.

# Master switch for the remote host.
# Read from: .env files or the real environment
# Values: true | false (also 1/0, yes/no, on/off)
# Default: false | Required: no | Secret: no
# Example: REMOTE_ENABLED=true
# REMOTE_ENABLED=false

# Host name or address of the RDP host (no scheme, path or spaces).
# Read from: .env files or the real environment
# Values: a host name or IP address
# Default: unset | Required: yes when REMOTE_ENABLED=true | Secret: no
# Example: REMOTE_RDP_HOST=rdp-host.example.internal
# REMOTE_RDP_HOST=

# RDP port of the host.
# Read from: .env files or the real environment
# Values: a whole number from 1 to 65535
# Default: 3389 | Required: no | Secret: no
# Example: REMOTE_RDP_PORT=3389
# REMOTE_RDP_PORT=3389

# Login for the RDP host. May carry the domain as DOMAIN\user (do not double-quote a value with backslashes, see the TIP above).
# Read from: .env files or the real environment
# Values: a user name, or DOMAIN\user
# Default: unset | Required: yes with REMOTE_AGENT_START=alternate-shell (this machine logs in for you); no for startup / manual | Secret: no
# Example: REMOTE_RDP_USER='EXAMPLE\svc-tests'
# REMOTE_RDP_USER=

# Password for REMOTE_RDP_USER. Handed to mstsc through cmdkey only while it connects.
# Read from: .env files or the real environment
# Values: any text (wrap a value containing # $ or quotes in double quotes)
# Default: unset | Required: yes with REMOTE_AGENT_START=alternate-shell | Secret: YES - .env.<name>.local or a CI secret, never a committed file
# Example (in .env.qa.local): REMOTE_RDP_PASSWORD="replace-me"
# REMOTE_RDP_PASSWORD=

# Domain of the login, as an alternative to writing DOMAIN\user in REMOTE_RDP_USER (a contradiction between the two is an error).
# Read from: .env files or the real environment
# Values: a domain name
# Default: unset | Required: no | Secret: no
# Example: REMOTE_RDP_DOMAIN=EXAMPLE
# REMOTE_RDP_DOMAIN=

# The mailbox folder on the test machine: requests and answers travel through it as files. Git-ignored; keep it in a folder only the test user can read.
# Read from: .env files or the real environment
# Values: a folder path
# Default: <folder tests start in>/.remote-mailbox | Required: no | Secret: no
# Example: REMOTE_SHARE_DIR=.remote-mailbox
# REMOTE_SHARE_DIR=.remote-mailbox

# The drive letter (made with subst) that is redirected into the RDP session. Never a real drive.
# Read from: .env files or the real environment
# Values: one letter D-Z (A, B and C are refused; a letter mapped to another folder is refused)
# Default: R | Required: no | Secret: no
# Example: REMOTE_DRIVE_LETTER=R
# REMOTE_DRIVE_LETTER=R

# How the agent gets started inside the RDP session of the host.
# Read from: .env files or the real environment
# Values: alternate-shell (mstsc starts the agent instead of Explorer) | startup (installed once in the host's Startup folder) | manual (you run start.cmd)
# Default: alternate-shell | Required: no | Secret: no
# Example: REMOTE_AGENT_START=startup
# REMOTE_AGENT_START=alternate-shell

# What the agent may be asked to do. Checked on the client and again on the agent.
# Read from: .env files or the real environment
# Values: a comma-separated list of http, db, sap, exec - add exec only deliberately: it runs arbitrary commands on the host
# Default: http,db,sap | Required: no | Secret: no
# Example: REMOTE_ALLOW=http,db
# REMOTE_ALLOW=http,db,sap

# How long connect() waits for the agent's first heartbeat.
# Read from: .env files or the real environment
# Values: milliseconds, 1 to 3600000
# Default: 180000 | Required: no | Secret: no
# Example: REMOTE_CONNECT_TIMEOUT_MS=300000
# REMOTE_CONNECT_TIMEOUT_MS=180000

# How long one request waits for its answer, unless the caller passes its own timeout.
# Read from: .env files or the real environment
# Values: milliseconds, 1 to 3600000
# Default: 60000 | Required: no | Secret: no
# Example: REMOTE_REQUEST_TIMEOUT_MS=120000
# REMOTE_REQUEST_TIMEOUT_MS=60000

# How often the client (and the agent) look at the mailbox folder.
# Read from: .env files or the real environment
# Values: milliseconds, 10 to 10000
# Default: 200 | Required: no | Secret: no
# Example: REMOTE_POLL_MS=500
# REMOTE_POLL_MS=200

# How often the agent writes its heartbeat file.
# Read from: .env files or the real environment
# Values: milliseconds, 100 to 60000
# Default: 2000 | Required: no | Secret: no
# Example: REMOTE_HEARTBEAT_MS=2000
# REMOTE_HEARTBEAT_MS=2000

# A heartbeat older than this means the agent is gone (AGENT_STALE).
# Read from: .env files or the real environment
# Values: milliseconds, 200 to 3600000, at least twice REMOTE_HEARTBEAT_MS
# Default: 10000 | Required: no | Secret: no
# Example: REMOTE_HEARTBEAT_STALE_MS=20000
# REMOTE_HEARTBEAT_STALE_MS=10000

# Width of the RDP desktop.
# Read from: .env files or the real environment
# Values: pixels, 200 to 8192
# Default: 1280 | Required: no | Secret: no
# Example: REMOTE_RDP_WIDTH=1920
# REMOTE_RDP_WIDTH=1280

# Height of the RDP desktop.
# Read from: .env files or the real environment
# Values: pixels, 200 to 8192
# Default: 800 | Required: no | Secret: no
# Example: REMOTE_RDP_HEIGHT=1080
# REMOTE_RDP_HEIGHT=800

# Leave the RDP session running after the tests (true), or shut it down and close our mstsc (false).
# Read from: .env files or the real environment
# Values: true | false
# Default: false | Required: no | Secret: no
# Example: REMOTE_RDP_KEEP_OPEN=true
# REMOTE_RDP_KEEP_OPEN=false

# close() also logs the Windows session on the host off (for startup / manual, where the session would otherwise stay).
# Read from: .env files or the real environment
# Values: true | false
# Default: false | Required: no | Secret: no
# Example: REMOTE_LOGOFF=true
# REMOTE_LOGOFF=false

# The .NET DbProviderFactories invariant name used for database steps on the host. The provider must exist on the host.
# Read from: .env files or the real environment
# Values: System.Data.SqlClient | System.Data.Odbc | System.Data.OleDb | another installed provider
# Default: unset | Required: yes for database steps on the host | Secret: no
# Example: REMOTE_DB_PROVIDER=System.Data.SqlClient
# REMOTE_DB_PROVIDER=

# The database connection string AS THE HOST uses it.
# Read from: .env files or the real environment
# Values: a provider-specific connection string (wrap it in double quotes: it contains ; = and often $ or #)
# Default: unset | Required: yes for database steps on the host | Secret: YES - .env.<name>.local or a CI secret, never a committed file
# Example (in .env.qa.local): REMOTE_DB_CONNECTION_STRING="Server=db.internal;Database=orders;User Id=svc;Password=replace-me;"
# REMOTE_DB_CONNECTION_STRING=


# ---- Connection details the CALLER reads (README: "Where connection details actually live") ----------------------------
# utils never reads these itself: SmtpClient and SftpClient take their settings as parameters. These names are the
# convention used in the README and the JSDoc examples (env.get('SMTP_HOST') ...), which is why they are listed here.

# SMTP server for SmtpClient / sendEmail.
# Read from: .env files or the real environment, by YOUR code through loadEnv() (not by utils)
# Values: a host name
# Default: unset | Required: only if your tests send mail | Secret: no
# Example: SMTP_HOST=smtp.qa.example.com
# SMTP_HOST=

# SMTP port.
# Read from: .env files or the real environment, by YOUR code
# Values: a whole number, usually 25, 465 or 587
# Default: unset | Required: only if your tests send mail | Secret: no
# Example: SMTP_PORT=587
# SMTP_PORT=

# Use TLS from the first byte (port 465) instead of STARTTLS.
# Read from: .env files or the real environment, by YOUR code
# Values: true | false
# Default: unset | Required: only if your tests send mail | Secret: no
# Example: SMTP_SECURE=false
# SMTP_SECURE=

# SMTP login name.
# Read from: .env files or the real environment, by YOUR code
# Values: any text
# Default: unset | Required: only if the server needs a login | Secret: no
# Example: SMTP_USER=qa-mailer
# SMTP_USER=

# SMTP password.
# Read from: .env files or the real environment, by YOUR code
# Values: any text
# Default: unset | Required: only if the server needs a login | Secret: YES - .env.<name>.local or a CI secret
# Example (in .env.qa.local): SMTP_PASS="replace-me"
# SMTP_PASS=

# SFTP server for SftpClient.
# Read from: .env files or the real environment, by YOUR code
# Values: a host name
# Default: unset | Required: only if your tests use SFTP | Secret: no
# Example: SFTP_HOST=sftp.qa.example.com
# SFTP_HOST=

# SFTP login name.
# Read from: .env files or the real environment, by YOUR code
# Values: any text
# Default: unset | Required: only if your tests use SFTP | Secret: no
# Example: SFTP_USER=qa-transfer
# SFTP_USER=

# SFTP password.
# Read from: .env files or the real environment, by YOUR code
# Values: any text
# Default: unset | Required: only if your tests use SFTP | Secret: YES - .env.<name>.local or a CI secret
# Example (in .env.qa.local): SFTP_PASSWORD="replace-me"
# SFTP_PASSWORD=


# ---- Set by the machine, not by you ----------------------------------------------------------------------------------

# CI systems set this (GitLab: CI=true). It raises the retries default, forbids test.only, keeps all test output and turns console colour off.
# Read from: the real environment only
# Values: any non-empty value means "running in CI"
# Default: unset | Required: no (do not set it by hand unless you want the CI behaviour locally) | Secret: no
# Example: CI=1
# CI=

# Playwright sets this for every worker (0, 1, 2, ...); the logger prints it as [w2] and uses it for LOG_FILE_PER_WORKER. Do not set it yourself.
# Read from: the real environment only
# Values: a whole number, set by Playwright
# Default: unset outside a Playwright worker | Required: no | Secret: no
# Example: TEST_WORKER_INDEX=2
# TEST_WORKER_INDEX=

# The time zone of the Node process (dates, logs). Node itself reads it, and only from the real environment - a line in a .env file is NOT applied.
# Read from: the real environment only
# Values: an IANA zone name such as UTC or Europe/London
# Default: the machine's own time zone | Required: no | Secret: no
# Example: TZ=UTC
# TZ=UTC

# Windows sets this for an interactive logon (console or Remote Desktop); `automation-remote doctor` reads it to warn when the process is not on an interactive desktop (SAP GUI scripting needs one). Do not set it yourself.
# Read from: the real environment only
# Values: Console | RDP-Tcp#<n> | Services (set by Windows)
# Default: unset outside Windows | Required: no | Secret: no
# Example: SESSIONNAME=Console
# SESSIONNAME=

# The npm registry that scripts/setup.sh|.bat, create-package and publish-package install from. They run `npm config set registry` with it.
# Read from: the real environment only (the scripts run before any .env file could be read)
# Values: the registry URL of your organisation, e.g. an Artifactory npm repository
# Default: unset (npm keeps the registry it already uses; publish-package refuses to run without it) | Required: no for setup, yes for publish-package | Secret: no
# Example: NPM_REGISTRY_URL=https://artifactory.example.com/artifactory/api/npm/npm-virtual/
# NPM_REGISTRY_URL=

# ---- CI/CD variables (GitLab; set in the project's CI/CD settings or `variables:`, not in a .env file) ------------------
# Read by .gitlab-ci.yml and the shared pipeline template ci/templates/playwright.gitlab-ci.yml.

# Gate of the merge job: fail the pipeline when fewer tests than this actually ran (an all-skipped run is not a pass).
# Read from: the pipeline's CI/CD variables (the template's `variables:` block sets the default)
# Values: a whole number >= 0 (0 allows an empty run)
# Default: 1 | Required: no | Secret: no
# Example: AUTOMATION_MIN_EXECUTED=20
# AUTOMATION_MIN_EXECUTED=1

# Gate of the merge job: fail the pipeline when this many tests needed a retry to pass.
# Read from: the pipeline's CI/CD variables
# Values: a whole number (1 = any flaky test; 0 = gate off)
# Default: 3 | Required: no | Secret: no
# Example: AUTOMATION_FAIL_ON_FLAKY=1
# AUTOMATION_FAIL_ON_FLAKY=3

# Make the manual `audit` job also run lint, typecheck, test and security in the repo (slow).
# Read from: the pipeline's CI/CD variables
# Values: any non-empty value turns it on
# Default: unset (only the automated checks) | Required: no | Secret: no
# Example: AUDIT_RUN_GATES=1
# AUDIT_RUN_GATES=

# Mirror of Playwright's browser download CDN (for example in Artifactory), used by `npx playwright install` in the pipeline.
# Read from: the pipeline's CI/CD variables
# Values: a URL
# Default: unset (Playwright's own CDN) | Required: no | Secret: no
# Example: PLAYWRIGHT_DOWNLOAD_HOST=https://artifactory.example.com/artifactory/playwright-cdn
# PLAYWRIGHT_DOWNLOAD_HOST=
