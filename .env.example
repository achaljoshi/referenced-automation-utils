# Copy this to .env.<yourenv>.local for secrets that must never be committed
# (real passwords, tokens, connection strings). Anything here is safe to
# commit as a template/default - see .env.qa / .env.stage / .env.dev for the
# actual per-environment values used by this repo's own tests.

LOG_LEVEL=info
TZ=UTC

# Example values every consuming repo's own .env.<env> files add on top of
# this pattern (BASE_URL for UI, API_BASE_URL for API, etc.):
# BASE_URL=https://qa.example.com
# API_BASE_URL=https://api.qa.example.com
# API_KEY=replace-me

# ---- Remote desktop host (docs/REMOTE_DESKTOP.md) - NOT VERIFIED on a real Windows host ----
# Run DB / HTTP / SAP steps on a remote Windows host that is reachable only by Remote Desktop.
# Put REMOTE_RDP_PASSWORD and REMOTE_DB_CONNECTION_STRING in .env.<env>.local, never in a committed file.
# REMOTE_ENABLED=false
# REMOTE_RDP_HOST=rdp-host.example.internal
# REMOTE_RDP_PORT=3389
# REMOTE_RDP_USER=DOMAIN\svc-tests          # or set REMOTE_RDP_DOMAIN separately
# REMOTE_RDP_PASSWORD=                      # SECRET - .env.<env>.local only
# REMOTE_RDP_DOMAIN=
# REMOTE_SHARE_DIR=.remote-mailbox          # default <cwd>/.remote-mailbox
# REMOTE_DRIVE_LETTER=R                     # the subst drive redirected into the session (never a real drive)
# REMOTE_AGENT_START=alternate-shell        # alternate-shell | startup | manual
# REMOTE_ALLOW=http,db,sap                  # add exec only deliberately: it runs arbitrary commands on the host
# REMOTE_CONNECT_TIMEOUT_MS=180000
# REMOTE_REQUEST_TIMEOUT_MS=60000
# REMOTE_POLL_MS=200
# REMOTE_HEARTBEAT_MS=2000
# REMOTE_HEARTBEAT_STALE_MS=10000
# REMOTE_RDP_WIDTH=1280
# REMOTE_RDP_HEIGHT=800
# REMOTE_RDP_KEEP_OPEN=false                # true: leave the RDP session running after the tests
# REMOTE_LOGOFF=false                       # true: close() also logs the host session off
# REMOTE_DB_PROVIDER=System.Data.SqlClient  # a .NET DbProviderFactories invariant name (System.Data.Odbc, ...)
# REMOTE_DB_CONNECTION_STRING=              # SECRET - .env.<env>.local only
